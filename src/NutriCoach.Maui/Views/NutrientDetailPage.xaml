<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCoach.Maui.Views.NutrientDetailPage"
             BackgroundColor="{StaticResource ColorBackground}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <BoxView Grid.Row="0" HeightRequest="5" WidthRequest="42" CornerRadius="3"
                 Color="{StaticResource ColorBorder}" HorizontalOptions="Center" Margin="0,10,0,0"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

                <Label Text="{Binding SourcesHeader}" FontFamily="InterBold" FontSize="18" TextColor="{StaticResource ColorTextPrimary}"/>

                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasSources}"
                                     BindableLayout.ItemsSource="{Binding Sources}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{StaticResource ColorSurface}" CornerRadius="14" Padding="14" Margin="0,0,0,8"
                                   HasShadow="False" BorderColor="Transparent">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource ColorTextPrimary}"/>
                                        <Label FontSize="11" TextColor="{StaticResource ColorTextSecondary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Kcal, StringFormat='{0:0} kcal · '}"/>
                                                    <Span Text="{Binding AmountGrams, StringFormat='{0:0} g'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource ColorTextPrimary}" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding NutrientAmount, StringFormat='{0:0.#}'}"/>
                                                <Span Text="{Binding Unit, StringFormat=' {0}'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Heute noch keine Quelle für diesen Nährstoff eingetragen." FontSize="13"
                       TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding HasSources, Converter={StaticResource InverseBoolConverter}}"/>

                <Label Text="ZUSÄTZLICHE INFORMATIONEN" Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,0"/>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAboutCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" FontFamily="InterSemiBold" FontSize="15" TextColor="{StaticResource ColorTextPrimary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Über "/>
                                        <Span Text="{Binding Name}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding AboutChevron}" FontFamily="FontAwesomeSolid" FontSize="14"
                                   TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="{Binding About}" FontSize="13" TextColor="{StaticResource ColorTextSecondary}"
                               IsVisible="{Binding IsAboutExpanded}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleEffectCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Wie wirkt es auf mich?" FontFamily="InterSemiBold" FontSize="15" TextColor="{StaticResource ColorTextPrimary}"/>
                            <Label Grid.Column="1" Text="{Binding EffectChevron}" FontFamily="FontAwesomeSolid" FontSize="14"
                                   TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="{Binding Effect}" FontSize="13" TextColor="{StaticResource ColorTextSecondary}"
                               IsVisible="{Binding IsEffectExpanded}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="{StaticResource ColorSurfaceElevated}" Margin="20,0,20,24" Padding="0,14" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="999"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped"/>
            </Border.GestureRecognizers>
            <Label Text="Schließen" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource ColorTextPrimary}" HorizontalTextAlignment="Center"/>
        </Border>
    </Grid>
</ContentPage>
