<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCoach.Maui.Views.RecipeDetailPage"
             BackgroundColor="{StaticResource ColorBackground}">

    <ContentPage.Resources>
        <DataTemplate x:Key="IngredientLineTemplate">
            <Grid ColumnDefinitions="Auto,*" Padding="0,3">
                <Label Grid.Column="0" Text="•" FontFamily="InterSemiBold" FontSize="13" Margin="0,0,8,0"/>
                <Label Grid.Column="1" Text="{Binding .}" FontSize="13" LineBreakMode="WordWrap"/>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource HeadlineLabelStyle}"/>
                <Label Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="18" VerticalOptions="Start" BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Label Text="{Binding CategoryAreaLabel}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding HasCategoryAreaLabel}"/>

            <Border StrokeThickness="0" HeightRequest="200" BackgroundColor="{StaticResource ColorSurfaceElevated}" IsVisible="{Binding HasThumbnail}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill"/>
            </Border>

            <Button Text="{Binding FavoriteButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleFavoriteCommand}"/>

            <!-- Zutaten -->
            <Frame Style="{StaticResource CardStyle}" IsVisible="{Binding HasIngredients}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Zutaten" FontFamily="InterSemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding IngredientLines}" BindableLayout.ItemTemplate="{StaticResource IngredientLineTemplate}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Zubereitung -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Zubereitung" FontFamily="InterSemiBold" FontSize="14"/>
                    <Label Text="{Binding InstructionsText}" FontSize="13" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
