<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCoach.Maui.Views.AddTrainingPage"
             BackgroundColor="{StaticResource ColorBackground}"
             x:Name="Root">

    <ContentPage.Resources>
        <DataTemplate x:Key="ExerciseBlockTemplate">
            <Frame BackgroundColor="{StaticResource ColorSurfaceElevated}" CornerRadius="14" Padding="12" Margin="0,0,0,10" HasShadow="False" BorderColor="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                        <Label Grid.Column="0" Text="{Binding ExerciseName}" FontFamily="InterSemiBold" FontSize="14"/>
                        <Label Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="14" BackgroundColor="Transparent" TextColor="{StaticResource ColorTextSecondary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.RemoveExerciseCommand, Source={x:Reference Root}}"
                                                       CommandParameter="{Binding}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label Text="{Binding MuscleInfo}" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                    <Label Text="{Binding Tip}" FontSize="10" TextColor="{StaticResource ColorAccent}" IsVisible="{Binding HasTip}"/>

                    <!-- Sätze (Kraft/Körpergewicht) -->
                    <VerticalStackLayout IsVisible="{Binding IsSetsBased}" Spacing="4">
                        <CollectionView ItemsSource="{Binding Sets}" ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="70,20,70,Auto" Padding="0,3">
                                        <Entry Grid.Column="0" Text="{Binding WeightKg}" Keyboard="Numeric" FontSize="12" HeightRequest="36"/>
                                        <Label Grid.Column="1" Text="×" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Entry Grid.Column="2" Text="{Binding Reps}" Keyboard="Numeric" FontSize="12" HeightRequest="36"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="+ Satz" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="10,4" HorizontalOptions="Start"
                                Command="{Binding AddSetCommand}"/>
                    </VerticalStackLayout>

                    <!-- Cardio -->
                    <VerticalStackLayout IsVisible="{Binding IsCardioBased}" Spacing="4">
                        <Label Text="Dauer (Minuten)" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                        <Entry Text="{Binding DurationMinutes}" Keyboard="Numeric"/>
                        <Label Text="Distanz (km)" FontSize="11" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding ShowDistance}"/>
                        <Entry Text="{Binding DistanceKm}" Keyboard="Numeric" IsVisible="{Binding ShowDistance}"/>
                        <Label Text="Widerstand" FontSize="11" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding ShowResistance}"/>
                        <Entry Text="{Binding ResistanceLevel}" Keyboard="Numeric" IsVisible="{Binding ShowResistance}"/>
                        <Label Text="Steigung (%)" FontSize="11" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding ShowIncline}"/>
                        <Entry Text="{Binding InclinePercent}" Keyboard="Numeric" IsVisible="{Binding ShowIncline}"/>
                        <Label Text="Ort" FontSize="11" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding ShowDistance}"/>
                        <Picker ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding Location}" IsVisible="{Binding ShowDistance}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>

        <DataTemplate x:Key="ExerciseResultTemplate">
            <Frame BackgroundColor="{StaticResource ColorSurface}" CornerRadius="12" Padding="10" Margin="0,0,0,6" HasShadow="False" BorderColor="Transparent">
                <Grid ColumnDefinitions="*" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.SelectExerciseCommand, Source={x:Reference Root}}"
                                               CommandParameter="{Binding}"/>
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="13"/>
                        <Label FontSize="10" TextColor="{StaticResource ColorTextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding PrimaryMuscleGroup}"/>
                                    <Span Text=" · "/>
                                    <Span Text="{Binding Equipment}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding WindowHeadline}" Style="{StaticResource HeadlineLabelStyle}"/>
                <Label Grid.Column="1" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="18" BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsNotEditMode}" Spacing="6">
                <Label Text="Name (z. B. Push Day, Beine)" Style="{StaticResource SectionLabelStyle}"/>
                <Entry Text="{Binding SessionName}"/>
            </VerticalStackLayout>

            <Label Text="Übung suchen und hinzufügen" Style="{StaticResource SectionLabelStyle}"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding SearchText}" Placeholder="z. B. Bankdrücken"/>
                <Button Grid.Column="1" Text="Suchen" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}"/>
            </Grid>
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSearching}">
                <ActivityIndicator IsRunning="True" Color="{StaticResource ColorAccent}" WidthRequest="16" HeightRequest="16"/>
                <Label Text="Durchsuche lokale und Online-Datenbank..." FontSize="11" TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <CollectionView ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource ExerciseResultTemplate}" ItemSizingStrategy="MeasureAllItems"/>

            <Label Text="Ausgewählte Übungen" FontFamily="InterSemiBold" FontSize="14" Margin="0,8,0,0" IsVisible="{Binding HasExercises}"/>
            <CollectionView ItemsSource="{Binding Exercises}" ItemTemplate="{StaticResource ExerciseBlockTemplate}" ItemSizingStrategy="MeasureAllItems"/>

            <Button Text="{Binding SaveButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
