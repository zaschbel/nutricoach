<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NutriCoach.App.Models;assembly=NutriCoach"
             xmlns:local="clr-namespace:NutriCoach.Maui"
             x:Class="NutriCoach.Maui.Views.ErnaehrungPage"
             BackgroundColor="{StaticResource ColorBackground}">

    <ContentView.Resources>
        <DataTemplate x:Key="MealEntryTemplate">
            <Frame BackgroundColor="{StaticResource ColorSurface}" CornerRadius="14" Padding="10" Margin="0,0,0,6" HasShadow="False" BorderColor="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditEntryCommand, Source={x:Static local:AppState.MainViewModel}}"
                                               CommandParameter="{Binding}"/>
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" Stroke="{StaticResource ColorSuccess}" StrokeThickness="2" Margin="0,0,10,0"
                            BackgroundColor="{StaticResource ColorSurfaceElevated}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Grid>
                            <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}"/>
                            <Label Text="{Binding Icon}" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   IsVisible="{Binding HasPhoto, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="13"/>
                        <Label FontSize="10" TextColor="{StaticResource ColorTextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding AmountGrams, StringFormat='{0:0}g · '}"/>
                                    <Span Text="{Binding Protein, StringFormat='{0:0.0}g E · '}"/>
                                    <Span Text="{Binding Carbs, StringFormat='{0:0.0}g K · '}"/>
                                    <Span Text="{Binding Fat, StringFormat='{0:0.0}g F'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding Kcal, StringFormat='{0:0} kcal'}" FontFamily="InterSemiBold" FontSize="12"
                           TextColor="{StaticResource ColorSuccess}" VerticalOptions="Center"/>
                </Grid>
            </Frame>
        </DataTemplate>
        <DataTemplate x:Key="NutrientCardTemplate">
            <Frame Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12" WidthRequest="164" FlexLayout.Basis="48%">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNutrientCardTapped"/>
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="13" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="{Binding Icon}" TextColor="{StaticResource ColorTextPrimary}"/>
                                <Span Text="  "/>
                                <Span Text="{Binding Name}" FontFamily="InterSemiBold" TextColor="{StaticResource ColorTextPrimary}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <ProgressBar Progress="{Binding ProgressRatio}" ProgressColor="{StaticResource ColorSuccess}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" LineBreakMode="NoWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Current, StringFormat='{0:0.0}'}" FontFamily="InterBold" FontSize="16" TextColor="{StaticResource ColorTextPrimary}"/>
                                    <Span Text="{Binding Goal, StringFormat=' / {0:0.#}'}" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                                    <Span Text="{Binding Unit, StringFormat=' {0}'}" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1" Text="&#xf105;" FontFamily="FontAwesomeSolid" FontSize="14"
                               TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Fixer Kopfbereich: Titel+Flamme, direkt darunter der Kalender ohne Seitenraender - beides
             bleibt beim Scrollen sichtbar, wie bei der MCI-Vorlage "ganz oben mit dem Bildschirm verbunden". -->
        <VerticalStackLayout Grid.Row="0" Spacing="0" BackgroundColor="{StaticResource ColorBackground}">
            <Grid ColumnDefinitions="*,Auto" Padding="16,12,16,8">
                <Label Grid.Column="0" Text="ERNÄHRUNG" FontFamily="InterBold" FontSize="22" CharacterSpacing="0.5" TextColor="{StaticResource ColorTextPrimary}" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="&#xf06d;" FontFamily="FontAwesomeSolid" FontSize="16" TextColor="#FF7A45" VerticalOptions="Center"/>
                    <Label Text="{Binding CurrentStreakDays}" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource ColorTextPrimary}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <Border BackgroundColor="{StaticResource ColorSurface}" StrokeThickness="0" Padding="16,6,16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,24,24"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <!-- Nur Hoch/Runter per Swipe (kollidiert nicht mit dem seitlichen Wischen zwischen
                         den Reitern in MainTabsPage). Links/Rechts bewusst als Buttons statt Swipe, weil
                         ein horizontaler Wisch hier sonst gleichzeitig den Reiter mitgewechselt hat. -->
                    <SwipeGestureRecognizer Direction="Down" Command="{Binding ToggleCalendarViewCommand}"/>
                    <SwipeGestureRecognizer Direction="Up" Command="{Binding ToggleCalendarViewCommand}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding MonthLabel}" FontSize="13" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding IsMonthView}"/>

                    <!-- Wochenansicht: Vor/Zurueck als Buttons links/rechts der Tage (kein Swipe, s.o.) -->
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsWeekView}">
                    <Label Grid.Column="0" Text="&#xf104;" FontFamily="FontAwesomeSolid" FontSize="16"
                           TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" Padding="10,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwipeCalendarRightCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4"
                                           BindableLayout.ItemsSource="{Binding WeekDays}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,8" WidthRequest="42">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorSuccess}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectDayCommand, Source={x:Static local:AppState.MainViewModel}}"
                                                               CommandParameter="{Binding}"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="{Binding DayAbbrev}" FontSize="10" HorizontalTextAlignment="Center">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                        <Label Text="{Binding DayNumber}" FontSize="14" FontFamily="InterSemiBold" HorizontalTextAlignment="Center">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                        <Label Text="&#xf236;" FontFamily="FontAwesomeSolid" FontSize="9" HorizontalTextAlignment="Center" IsVisible="{Binding IsRestDay}"/>
                                        <BoxView HeightRequest="4" WidthRequest="4" CornerRadius="2" HorizontalOptions="Center"
                                                 Color="{StaticResource ColorSuccess}" IsVisible="{Binding HasEntries}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesomeSolid" FontSize="16"
                           TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" Padding="10,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwipeCalendarLeftCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    </Grid>

                    <!-- Monatsansicht: 7-Spalten-Raster, Vor/Zurueck ebenfalls als Buttons -->
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsMonthView}">
                    <Label Grid.Column="0" Text="&#xf104;" FontFamily="FontAwesomeSolid" FontSize="16"
                           TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" Padding="10,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwipeCalendarRightCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <VerticalStackLayout Grid.Column="1" Spacing="2"
                                BindableLayout.ItemsSource="{Binding MonthWeeks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <!-- Eine Wochenzeile - exakt dieselbe HorizontalStackLayout+BindableLayout-Struktur
                                     wie die Wochenansicht, nur je Woche einmal statt FlexLayout mit allen Tagen auf einmal. -->
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" BindableLayout.ItemsSource="{Binding .}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,6" WidthRequest="42" BackgroundColor="Transparent">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ColorSuccess}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectDayCommand, Source={x:Static local:AppState.MainViewModel}}"
                                                                           CommandParameter="{Binding}"/>
                                                </Grid.GestureRecognizers>
                                                <VerticalStackLayout HorizontalOptions="Center" IsVisible="{Binding IsBlank, Converter={StaticResource InverseBoolConverter}}">
                                                    <Label Text="{Binding DayNumber}" FontSize="14" FontFamily="InterSemiBold" HorizontalTextAlignment="Center">
                                                        <Label.Style>
                                                            <Style TargetType="Label">
                                                                <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="TextColor" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Label.Style>
                                                    </Label>
                                                    <BoxView HeightRequest="4" WidthRequest="4" CornerRadius="2" HorizontalOptions="Center"
                                                             Color="{StaticResource ColorSuccess}" IsVisible="{Binding HasEntries}"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesomeSolid" FontSize="16"
                           TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center" Padding="10,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwipeCalendarLeftCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

            <!-- Übersicht -->
            <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,0">
                <Label Grid.Column="0" Text="ÜBERSICHT" Style="{StaticResource SectionLabelStyle}" VerticalOptions="Center"/>
                <Border Grid.Column="1" Stroke="{StaticResource ColorSuccess}" StrokeThickness="1" BackgroundColor="Transparent" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999"/>
                    </Border.StrokeShape>
                    <Label Text="{Binding GoalBadgeText}" FontSize="10" FontFamily="InterBold" TextColor="{StaticResource ColorSuccess}"/>
                </Border>
            </Grid>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <!-- Kalorien-Bogen: bewusst kompakt und mittig statt kartenbreit, damit Gegessen/Ziel
                         direkt neben den offenen Enden des Bogens sitzen - wie im MCI-Vorbild, nicht mit
                         grossem Abstand darunter. -->
                    <Grid HeightRequest="140">
                        <GraphicsView Drawable="{Binding CalorieGaugeDrawable}" WidthRequest="230" HeightRequest="100"
                                      HorizontalOptions="Center" VerticalOptions="Start"/>

                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Margin="0,24,0,0">
                            <Label Text="{Binding RemainingKcal, StringFormat='{0:0}'}" FontFamily="InterBold" FontSize="26"
                                   TextColor="{StaticResource ColorTextPrimary}" HorizontalTextAlignment="Center"/>
                            <Label FontSize="12" TextColor="{StaticResource ColorTextSecondary}" HorizontalTextAlignment="Center">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="Text" Value="Übrig"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverTarget}" Value="True">
                                                <Setter Property="Text" Value="Über Ziel"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" VerticalOptions="Start" Margin="4,86,4,0">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start">
                                <Label Text="{Binding Totals.Kcal, StringFormat='{0:0}'}" FontFamily="InterSemiBold" FontSize="16"/>
                                <Label Text="Gegessen" FontSize="10" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding AdjustedCalorieTarget, StringFormat='{0:0}'}" FontFamily="InterSemiBold" FontSize="16" HorizontalTextAlignment="End"/>
                                <Label Text="Ziel" FontSize="10" TextColor="{StaticResource ColorTextSecondary}" HorizontalTextAlignment="End"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>

                    <!-- Makro-Balken -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Proteine" FontSize="12"/>
                            <Label Grid.Column="1" Text="{Binding ProteinLabel}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                        </Grid>
                        <ProgressBar Progress="{Binding ProteinProgressRatio}" ProgressColor="#4FB0AE" HeightRequest="6"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Kohlenhydrate" FontSize="12"/>
                            <Label Grid.Column="1" Text="{Binding CarbsLabel}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                        </Grid>
                        <ProgressBar Progress="{Binding CarbsProgressRatio}" ProgressColor="{StaticResource ColorSuccess}" HeightRequest="6"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Fette" FontSize="12"/>
                            <Label Grid.Column="1" Text="{Binding FatLabel}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                        </Grid>
                        <ProgressBar Progress="{Binding FatProgressRatio}" ProgressColor="#E0A458" HeightRequest="6"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Heutige Mahlzeiten -->
            <Label Text="Heutige Mahlzeiten" FontFamily="InterSemiBold" FontSize="16" Margin="0,6,0,0"/>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBreakfastHeaderTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource ColorTextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="&#xf7fb;" TextColor="{StaticResource ColorTextSecondary}"/>
                                <Span Text=" Frühstück" FontFamily="InterSemiBold" TextColor="{StaticResource ColorTextSecondary}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding HasBreakfastEntries, Converter={StaticResource CheckmarkConverter}}" FontSize="16" TextColor="{StaticResource ColorSuccess}"/>
                </Grid>
                <CollectionView ItemsSource="{Binding Breakfast}" ItemTemplate="{StaticResource MealEntryTemplate}" ItemSizingStrategy="MeasureAllItems" IsVisible="{Binding HasBreakfastEntries}"/>
                <Label Text="Noch nichts eingetragen" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" Margin="0,6,0,0" IsVisible="{Binding HasBreakfastEntries, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Text="+ Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Start"
                        Command="{Binding AddFoodCommand}" CommandParameter="{x:Static models:MealType.Frühstück}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLunchHeaderTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource ColorTextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="&#xe4c6;" TextColor="{StaticResource ColorTextSecondary}"/>
                                <Span Text=" Mittagessen" FontFamily="InterSemiBold" TextColor="{StaticResource ColorTextSecondary}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding HasLunchEntries, Converter={StaticResource CheckmarkConverter}}" FontSize="16" TextColor="{StaticResource ColorSuccess}"/>
                </Grid>
                <CollectionView ItemsSource="{Binding Lunch}" ItemTemplate="{StaticResource MealEntryTemplate}" ItemSizingStrategy="MeasureAllItems" IsVisible="{Binding HasLunchEntries}"/>
                <Label Text="Noch nichts eingetragen" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" Margin="0,6,0,0" IsVisible="{Binding HasLunchEntries, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Text="+ Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Start"
                        Command="{Binding AddFoodCommand}" CommandParameter="{x:Static models:MealType.Mittagessen}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDinnerHeaderTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource ColorTextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="&#xf2e7;" TextColor="{StaticResource ColorTextSecondary}"/>
                                <Span Text=" Abendessen" FontFamily="InterSemiBold" TextColor="{StaticResource ColorTextSecondary}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding HasDinnerEntries, Converter={StaticResource CheckmarkConverter}}" FontSize="16" TextColor="{StaticResource ColorSuccess}"/>
                </Grid>
                <CollectionView ItemsSource="{Binding Dinner}" ItemTemplate="{StaticResource MealEntryTemplate}" ItemSizingStrategy="MeasureAllItems" IsVisible="{Binding HasDinnerEntries}"/>
                <Label Text="Noch nichts eingetragen" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" Margin="0,6,0,0" IsVisible="{Binding HasDinnerEntries, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Text="+ Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Start"
                        Command="{Binding AddFoodCommand}" CommandParameter="{x:Static models:MealType.Abendessen}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSnackHeaderTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource ColorTextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="&#xf5d1;" TextColor="{StaticResource ColorTextSecondary}"/>
                                <Span Text=" Snacks" FontFamily="InterSemiBold" TextColor="{StaticResource ColorTextSecondary}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding HasSnackEntries, Converter={StaticResource CheckmarkConverter}}" FontSize="16" TextColor="{StaticResource ColorSuccess}"/>
                </Grid>
                <CollectionView ItemsSource="{Binding Snacks}" ItemTemplate="{StaticResource MealEntryTemplate}" ItemSizingStrategy="MeasureAllItems" IsVisible="{Binding HasSnackEntries}"/>
                <Label Text="Noch nichts eingetragen" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" Margin="0,6,0,0" IsVisible="{Binding HasSnackEntries, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Text="+ Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" HorizontalOptions="Start"
                        Command="{Binding AddFoodCommand}" CommandParameter="{x:Static models:MealType.Snack}"/>
            </VerticalStackLayout>

            <!-- Rezepte entdecken -->
            <Frame Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRecipesCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="&#xf02d;" FontFamily="FontAwesomeSolid" FontSize="20" BackgroundColor="#34C77A1A"
                           WidthRequest="44" HeightRequest="44" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Rezepte entdecken" FontFamily="InterSemiBold" FontSize="15"/>
                        <Label Text="Echte Rezepte mit Zutaten &amp; Zubereitung durchsuchen" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf105;" FontFamily="FontAwesomeSolid" FontSize="16" TextColor="{StaticResource ColorTextSecondary}" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Körpergewicht - direkt vor den Nährwert-Detailkarten -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label FontFamily="InterSemiBold" FontSize="15">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FontAwesomeSolid" Text="&#xf496;"/>
                                <Span Text=" Aktuelles Körpergewicht" FontFamily="InterSemiBold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="In 100g-Schritten einstellbar, wird für die Gewichts-Grafik in den Statistiken verwendet."
                           FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{Binding CurrentWeightKg, StringFormat='{0:0.0} kg'}" FontFamily="InterBold" FontSize="20"
                               VerticalOptions="Center" WidthRequest="90"/>
                        <Stepper Grid.Column="1" Minimum="30" Maximum="300" Increment="0.1" Value="{Binding CurrentWeightKg}" HorizontalOptions="Start"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Makros: zusätzliche Werte neben den drei Haupt-Makros oben -->
            <Label Text="MAKROS" Style="{StaticResource SectionLabelStyle}" Margin="2,10,0,0"/>
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"
                        BindableLayout.ItemsSource="{Binding ExtraMacroCards}"
                        BindableLayout.ItemTemplate="{StaticResource NutrientCardTemplate}"/>

            <!-- Vitamine -->
            <Label Text="VITAMINE" Style="{StaticResource SectionLabelStyle}" Margin="2,4,0,0"/>
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"
                        BindableLayout.ItemsSource="{Binding VitaminCards}"
                        BindableLayout.ItemTemplate="{StaticResource NutrientCardTemplate}"/>

            <!-- Mineralstoffe -->
            <Label Text="MINERALSTOFFE" Style="{StaticResource SectionLabelStyle}" Margin="2,4,0,0"/>
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"
                        BindableLayout.ItemsSource="{Binding MineralCards}"
                        BindableLayout.ItemTemplate="{StaticResource NutrientCardTemplate}"/>

            <!-- Weitere -->
            <Label Text="WEITERE" Style="{StaticResource SectionLabelStyle}" Margin="2,4,0,0"/>
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"
                        BindableLayout.ItemsSource="{Binding OtherNutrientCards}"
                        BindableLayout.ItemTemplate="{StaticResource NutrientCardTemplate}"/>

        </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1" x:Name="SuccessCheckmark" Text="&#xf058;" FontFamily="FontAwesomeSolid" FontSize="64"
               TextColor="{StaticResource ColorSuccess}" HorizontalOptions="Center" VerticalOptions="Center"
               Opacity="0" Scale="0.6" InputTransparent="True"/>
    </Grid>
</ContentView>
