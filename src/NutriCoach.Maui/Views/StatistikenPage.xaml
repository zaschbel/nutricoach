<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCoach.Maui.Views.StatistikenPage"
             BackgroundColor="{StaticResource ColorBackground}">

    <ContentView.Resources>
        <Style x:Key="SubTabLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubTabUnderlineStyle" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Color" Value="Transparent"/>
        </Style>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

            <!-- Unterreiter -->
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSubTabCommand}" CommandParameter="Ernährung"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Ernährung" Style="{StaticResource SubTabLabelStyle}"
                           TextColor="{Binding IsErnaehrungTab, Converter={StaticResource BoolToAccentConverter}}"/>
                    <BoxView Style="{StaticResource SubTabUnderlineStyle}"
                             Color="{Binding IsErnaehrungTab, Converter={StaticResource BoolToAccentOrTransparentConverter}}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSubTabCommand}" CommandParameter="Cardio"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Cardio" Style="{StaticResource SubTabLabelStyle}"
                           TextColor="{Binding IsCardioTab, Converter={StaticResource BoolToAccentConverter}}"/>
                    <BoxView Style="{StaticResource SubTabUnderlineStyle}"
                             Color="{Binding IsCardioTab, Converter={StaticResource BoolToAccentOrTransparentConverter}}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSubTabCommand}" CommandParameter="Zukunftsbild"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Zukunftsbild" Style="{StaticResource SubTabLabelStyle}"
                           TextColor="{Binding IsZukunftsbildTab, Converter={StaticResource BoolToAccentConverter}}"/>
                    <BoxView Style="{StaticResource SubTabUnderlineStyle}"
                             Color="{Binding IsZukunftsbildTab, Converter={StaticResource BoolToAccentOrTransparentConverter}}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ================= ERNÄHRUNG ================= -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsErnaehrungTab}">

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Körpergewicht" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding WeightCurrentLabel}" FontFamily="InterBold" FontSize="16"/>
                                <Label Text="{Binding WeightChangeLabel}" FontSize="13" TextColor="{StaticResource ColorSuccess}"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <GraphicsView Drawable="{Binding WeightChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Kalorien" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CalorieAverageLabel}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                        <GraphicsView Drawable="{Binding CalorieChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Proteine" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding ProteinAverageLabel}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                        <GraphicsView Drawable="{Binding ProteinChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Kohlenhydrate" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CarbsAverageLabel}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                        <GraphicsView Drawable="{Binding CarbsChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Fette" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding FatAverageLabel}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                        <GraphicsView Drawable="{Binding FatChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ================= CARDIO ================= -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsCardioTab}">
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Cardio-Minuten" FontFamily="InterSemiBold" FontSize="17"/>
                                <Label Text="Letzte 7 Tage" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding CardioAverageLabel}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                        <GraphicsView Drawable="{Binding CardioChartDrawable}" HeightRequest="150" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- ================= ZUKUNFTSBILD ================= -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsZukunftsbildTab}">

                <!-- Setup: noch kein Bild vorhanden -->
                <Frame Style="{StaticResource CardStyle}" IsVisible="{Binding IsFutureBodySetupVisible}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Dein Zukunftsbild" FontFamily="InterSemiBold" FontSize="17"/>
                        <Label FontSize="13" TextColor="{StaticResource ColorTextSecondary}"
                               Text="Mach ein Foto von dir oder wähle eines aus - die KI zeigt dir, wie du anhand deines Ziels und deines aktuellen Plans in etwa 6 Monaten realistisch aussehen könntest. Nutzt das gleiche kostenlose Gemini-Kontingent wie die Foto-Erkennung beim Essen."/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Foto aufnehmen" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnTakeFutureBodyPhotoClicked" ContentLayout="Left,6">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf083;" Color="White" Size="14"/>
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1" Text="Aus Galerie" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnPickFutureBodyPhotoClicked" ContentLayout="Left,6">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf03e;" Color="{DynamicResource ColorTextPrimary}" Size="14"/>
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                        <Label Text="{Binding FutureImageErrorMessage}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding HasFutureImageError}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Ladeanzeige während der KI-Generierung -->
                <Frame Style="{StaticResource CardStyle}" IsVisible="{Binding IsGeneratingFutureImage}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,12">
                        <ActivityIndicator IsRunning="True" Color="{StaticResource ColorAccent}" WidthRequest="28" HeightRequest="28"/>
                        <Label Text="Die KI erstellt dein Zukunftsbild... das kann einige Sekunden dauern." FontSize="13" TextColor="{StaticResource ColorTextSecondary}" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Vergleich: Vorher/Nachher-Schieberegler -->
                <Frame Style="{StaticResource CardStyle}" IsVisible="{Binding IsFutureBodyComparisonVisible}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Jetzt vs. in 6 Monaten" FontFamily="InterSemiBold" FontSize="17"/>

                        <Grid x:Name="ComparisonGrid" HeightRequest="400" SizeChanged="OnComparisonGridSizeChanged">
                            <Image x:Name="OriginalImage" Source="{Binding OriginalImagePath}" Aspect="AspectFill"/>
                            <Image x:Name="GeneratedImage" Source="{Binding GeneratedImagePath}" Aspect="AspectFill"/>
                            <BoxView x:Name="CompareDivider" WidthRequest="2" Color="White" HorizontalOptions="Start" VerticalOptions="Fill" InputTransparent="True"/>
                        </Grid>

                        <Slider x:Name="CompareSlider" Minimum="0" Maximum="1" Value="0.5" ValueChanged="OnCompareSliderValueChanged"/>
                        <Label Text="Schieberegler: links = jetzt, rechts = Zukunftsbild" FontSize="11" TextColor="{StaticResource ColorTextSecondary}"/>

                        <Label Text="{Binding ProjectedChangeLabel}" FontFamily="InterSemiBold" FontSize="14" Margin="0,4,0,0"/>

                        <Button Text="Neu generieren" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetFutureBodyCommand}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
