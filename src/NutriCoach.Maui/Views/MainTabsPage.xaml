<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NutriCoach.Maui.Views"
             x:Class="NutriCoach.Maui.Views.MainTabsPage"
             BackgroundColor="{StaticResource ColorBackground}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Wischbarer Inhalt: die vier Seiten liegen nebeneinander, wie auf einem echten Handy -->
        <CarouselView x:Name="Carousel" Grid.Row="0" IsSwipeEnabled="True" Loop="False"
                      PositionChanged="OnCarouselPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <ContentView Content="{Binding}"/>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Navigationsleiste verschmilzt bewusst mit dem Seitenhintergrund (keine eigene Kartenfarbe,
             keine Rundung, kein Schatten) - so wie bei der MCI-App als Vorbild: eine durchgehende Fläche
             ohne sichtbaren Farbbruch zwischen Inhalt, Leiste und dem Bereich unter dem Home-Indicator. -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource ColorBackground}" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*" Padding="8,10,8,26">

                <VerticalStackLayout Grid.Column="0" x:Name="TabHome" Spacing="2" HorizontalOptions="Center" BackgroundColor="Transparent">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabHomeTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <GraphicsView x:Name="IconHome" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label x:Name="LabelHome" Text="Home" FontSize="10" FontFamily="InterMedium" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource ColorAccent}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" x:Name="TabTraining" Spacing="2" HorizontalOptions="Center" BackgroundColor="Transparent">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTrainingTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <GraphicsView x:Name="IconTraining" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label x:Name="LabelTraining" Text="Training" FontSize="10" FontFamily="InterMedium" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource ColorTextSecondary}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" x:Name="TabErnaehrung" Spacing="2" HorizontalOptions="Center" BackgroundColor="Transparent">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabErnaehrungTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <GraphicsView x:Name="IconErnaehrung" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label x:Name="LabelErnaehrung" Text="Ernährung" FontSize="10" FontFamily="InterMedium" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource ColorTextSecondary}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" x:Name="TabStatistiken" Spacing="2" HorizontalOptions="Center" BackgroundColor="Transparent">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabStatistikenTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <GraphicsView x:Name="IconStatistiken" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label x:Name="LabelStatistiken" Text="Statistiken" FontSize="10" FontFamily="InterMedium" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource ColorTextSecondary}"/>
                </VerticalStackLayout>

            </Grid>
        </Border>
    </Grid>
</ContentPage>
