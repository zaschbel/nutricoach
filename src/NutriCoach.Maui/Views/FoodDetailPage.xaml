<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCoach.Maui.Views.FoodDetailPage"
             BackgroundColor="{StaticResource ColorBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurfaceElevated}"
                        IsVisible="{Binding Food.HasPhoto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Image Source="{Binding Food.PhotoPath}" Aspect="AspectFill"/>
                </Border>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{Binding Icon}" FontSize="30" IsVisible="{Binding Food.HasPhoto, Converter={StaticResource InverseBoolConverter}}"/>
                    <Label Text="{Binding Name}" Style="{StaticResource HeadlineLabelStyle}"/>
                    <Label Text="{Binding Brand}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}" IsVisible="{Binding HasBrand}"/>
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="&#xf00d;" FontFamily="FontAwesomeSolid" FontSize="18" VerticalOptions="Start" BackgroundColor="Transparent">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Makro-Verteilung -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Verteilung der Makronährstoffe" FontFamily="InterSemiBold" FontSize="14"/>

                    <GraphicsView Drawable="{Binding ChartDrawable}" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center" Margin="0,6,0,10"/>

                    <CollectionView ItemsSource="{Binding PieSlices}" ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="14,*,Auto" Padding="0,4">
                                    <BoxView Grid.Column="0" Color="{Binding Color}" CornerRadius="4" WidthRequest="14" HeightRequest="14"/>
                                    <Label Grid.Column="1" Text="{Binding Label}" FontSize="13" Margin="8,0,0,0"/>
                                    <Label Grid.Column="2" Text="{Binding Percent, StringFormat='{0:0}%'}" FontSize="13" TextColor="{StaticResource ColorTextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Menge -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Menge (Gramm)" Style="{StaticResource SectionLabelStyle}"/>
                    <Entry Text="{Binding AmountGrams}" Keyboard="Numeric"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Nährwerte -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nährwerte (pro Menge)" FontFamily="InterSemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Kalorien"/><Label Grid.Column="1" Text="{Binding Kcal, StringFormat='{0:0} kcal'}" TextColor="{StaticResource ColorAccent}" FontFamily="InterSemiBold"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Kohlenhydrate"/><Label Grid.Column="1" Text="{Binding Carbs, StringFormat='{0:0.0} g'}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="   davon Zucker" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/><Label Grid.Column="1" Text="{Binding Sugar, StringFormat='{0:0.0} g'}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Eiweiß"/><Label Grid.Column="1" Text="{Binding Protein, StringFormat='{0:0.0} g'}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Fett"/><Label Grid.Column="1" Text="{Binding Fat, StringFormat='{0:0.0} g'}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="   davon gesättigt" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/><Label Grid.Column="1" Text="{Binding SaturatedFat, StringFormat='{0:0.0} g'}" FontSize="12" TextColor="{StaticResource ColorTextSecondary}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Ballaststoffe"/><Label Grid.Column="1" Text="{Binding Fiber, StringFormat='{0:0.0} g'}"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Grid.Column="0" Text="Salz"/><Label Grid.Column="1" Text="{Binding Salt, StringFormat='{0:0.00} g'}"/></Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Bewertung -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding RatingIcon}" FontSize="18"/>
                        <Label Text="{Binding Rating}" FontFamily="InterSemiBold" FontSize="15"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding Explanation}" FontSize="13" TextColor="{StaticResource ColorTextSecondary}"/>
                    <Label Text="{Binding AlternativeHint}" FontSize="12" TextColor="{StaticResource ColorAccent}" IsVisible="{Binding HasAlternativeHint}"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Eintrag entfernen" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}"/>
            <Button Text="{Binding ConfirmButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}" Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
