<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:NutriCoach.Maui.Converters"
             x:Class="NutriCoach.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <conv:CheckmarkConverter x:Key="CheckmarkConverter"/>
            <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
            <conv:BoolToAccentConverter x:Key="BoolToAccentConverter"/>
            <conv:BoolToAccentOrTransparentConverter x:Key="BoolToAccentOrTransparentConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
            <conv:NullableIntConverter x:Key="NullableIntConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
