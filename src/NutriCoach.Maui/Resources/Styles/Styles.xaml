<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Globale Schriftart für alle Labels: Inter, wie im Stitch-Design -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <!-- Karten-Container ("squircle", weicher Schatten - Übersetzung des WPF-"Card"-Styles) -->
    <Style x:Key="CardStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="BorderColor" Value="Transparent"/>
    </Style>

    <!-- Primär-Button (blau, für Haupt-Aktionen) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="InterSemiBold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20,12"/>
    </Style>

    <!-- Sekundär-Button (dezenter grauer Wash statt Outline, wie im Design-System beschrieben) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurfaceElevated}"/>
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <Style x:Key="HeadlineLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="CharacterSpacing" Value="0.5"/>
    </Style>

</ResourceDictionary>
